      "parameters": {
        "sendTo": "Waqas@kavtech.net",
        "subject": "=Update on Multiple Disclosures",
        "message": "=<p>Hello Ahmed,</p>\n<p>I hope you're doing well!</p>\n<p>The following updates have been processed for both firms/individuals on FINRA - BrokerCheck:</p>\n\n<h3 style=\"color: #2c3e50;\">FIRM DISCLOSURES</h3>\n<table border=\"1\" cellpadding=\"8\" style=\"border-collapse: collapse; width: 100%; font-family: Arial, sans-serif;\">\n  <thead>\n    <tr style=\"background-color: #f2f2f2; text-align: left;\">\n      <th>CRD No.</th>\n      <th>File URL</th>\n      <th>Modified Date</th>\n    </tr>\n  </thead>\n  <tbody>\n    {{ $item(0).$json.firm_data.map(item => `\n      <tr>\n        <td>${item.firm_source_id}</td>\n        <td><a href=\"${item.url}\">${item.url}</a></td>\n        <td>${item.file_last_modified_date}</td>\n      </tr>`).join('') }}\n  </tbody>\n</table>\n\n<br>\n\n<h3 style=\"color: #2c3e50;\">INDIVIDUAL DISCLOSURES</h3>\n<table border=\"1\" cellpadding=\"8\" style=\"border-collapse: collapse; width: 100%; font-family: Arial, sans-serif;\">\n  <thead>\n    <tr style=\"background-color: #f2f2f2; text-align: left;\">\n      <th>CRD No.</th>\n      <th>File URL</th>\n      <th>Modified Date</th>\n    </tr>\n  </thead>\n  <tbody>\n    {{ $item(1).$json.individual_data.map(item => `\n      <tr>\n        <td>${item.ind_source_id}</td>\n        <td><a href=\"${item.url}\">${item.url}</a></td>\n        <td>${item.file_last_modified_date}</td>\n      </tr>`).join('') }}\n  </tbody>\n</table>\n\n<p style=\"margin-top: 20px;\">Best Regards,<br><strong>Ahmed Shafique</strong></p>\n",
        "options": {}
      },
